rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /rooms/{roomCode} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.revealed == false
        && request.resource.data.round == 1
        && request.resource.data.tickets == []
        && request.resource.data.currentTicket == null
        && request.resource.data.keys().hasOnly(
             ['createdAt', 'hostUid', 'deck', 'revealed', 'round', 'tickets', 'currentTicket', 'lastActivityAt', 'expiresAt']);

      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['revealed', 'round', 'tickets', 'currentTicket', 'lastActivityAt', 'expiresAt'])
        && request.resource.data.tickets is list
        && request.resource.data.tickets.size() <= 200
        && (request.resource.data.currentTicket == null || request.resource.data.currentTicket is string);

      allow delete: if false;

      match /participants/{uid} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() && uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.vote == null
          && request.resource.data.keys().hasOnly(
               ['name', 'vote', 'joinedAt', 'lastSeenAt', 'expiresAt']);

        allow update: if isSignedIn() && uid == request.auth.uid
          && request.resource.data.name == resource.data.name
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['vote', 'lastSeenAt', 'expiresAt']);

        allow delete: if isSignedIn() && uid == request.auth.uid;
      }
    }
  }
}
