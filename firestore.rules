rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAccentColor(value) {
      return value in ['green', 'blue', 'purple', 'pink', 'orange', 'teal'];
    }

    function isParticipantRole(value) {
      return value in ['voter', 'observer'];
    }

    function isJobRole(value) {
      return value in ['dev', 'qa', 'product'];
    }

    function isDeckId(value) {
      return value in ['fibonacci', 'fibonacciModified'];
    }

    function isRoomPhase(value) {
      return value in ['lobby', 'discussion', 'voting', 'revealed'];
    }

    match /rooms/{roomCode} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.phase == 'lobby'
        && request.resource.data.round == 1
        && request.resource.data.tickets == []
        && request.resource.data.currentTicket == null
        && request.resource.data.history == []
        && isAccentColor(request.resource.data.accentColor)
        && isDeckId(request.resource.data.deck)
        && request.resource.data.keys().hasOnly(
             ['createdAt', 'hostUid', 'deck', 'phase', 'round', 'tickets', 'currentTicket', 'accentColor', 'history', 'lastActivityAt', 'expiresAt', 'roundStartedAt']);

      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phase', 'round', 'tickets', 'currentTicket', 'accentColor', 'history', 'lastActivityAt', 'expiresAt', 'roundStartedAt'])
        && isRoomPhase(request.resource.data.phase)
        && request.resource.data.tickets is list
        && request.resource.data.tickets.size() <= 200
        && (request.resource.data.currentTicket == null || request.resource.data.currentTicket is string)
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 200
        && isAccentColor(request.resource.data.accentColor);

      allow delete: if false;

      match /participants/{uid} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() && uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && isParticipantRole(request.resource.data.role)
          && isJobRole(request.resource.data.jobRole)
          && request.resource.data.vote == null
          && request.resource.data.keys().hasOnly(
               ['name', 'role', 'jobRole', 'vote', 'joinedAt', 'lastSeenAt', 'expiresAt']);

        allow update: if isSignedIn() && uid == request.auth.uid
          && request.resource.data.name == resource.data.name
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['vote', 'role', 'jobRole', 'lastSeenAt', 'expiresAt'])
          && isParticipantRole(request.resource.data.role)
          && isJobRole(request.resource.data.jobRole)
          && (request.resource.data.vote == null
              || (request.resource.data.role == 'voter'
                  && get(/databases/$(database)/documents/rooms/$(roomCode)).data.phase == 'voting'));

        allow delete: if isSignedIn() && uid == request.auth.uid;
      }
    }
  }
}
